# Etsy AI Agent Configuration
# Copy this file to .env and fill in your values

# AI Provider (choose one)
# Option 1: Anthropic Claude (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# AI Model Settings
AI_PROVIDER=anthropic  # anthropic or openai
AI_MODEL=claude-sonnet-4-20250514  # or gpt-4-turbo

# Etsy API (Optional - for advanced features)
ETSY_API_KEY=your_etsy_api_key_here
ETSY_SHARED_SECRET=your_etsy_shared_secret_here

# Agent Settings
DEFAULT_LANGUAGE=zh  # zh for Chinese, en for English
MAX_RESULTS_PER_SEARCH=20
RATE_LIMIT_DELAY=2  # seconds between API calls
